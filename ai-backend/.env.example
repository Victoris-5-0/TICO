# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# The database URL is shared with the Next.js application.

# =============================================================================
# 1. DATABASE  —  Dashboard ▸ Connect  (green "Connect" button, top of the page)
# =============================================================================
# Choose the **Session pooler** string (port 5432), NOT the transaction pooler.
#
#   Session pooler     port 5432  ✅ use this — full Postgres, prepared statements fine
#   Transaction pooler port 6543  ❌ no prepared statements; needs extra psycopg2 config
#   Direct connection  port 5432  ❌ IPv6 only on most networks
#
# Then edit the string Supabase gives you in two ways:
#   a) change the scheme  postgresql://  ->  postgresql+psycopg2://
#   b) URL-encode the password if it contains @ : / ? # [ ] or %
#      (e.g. p@ss  ->  p%40ss)
#
DATABASE_URL=postgresql+psycopg2://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres


# =============================================================================
# 2. GOOGLE GEMINI  —  aistudio.google.com/apikey
# =============================================================================
# Check the rate limit on whichever tier this key is on. A per-minute cap that
# trips during the demo looks exactly like a broken service.
GOOGLE_API_KEY=


# =============================================================================
# 3. APP
# =============================================================================
ENVIRONMENT=development

# May this service call Gemini to compose a mission at all?
#
#   false (default)  NO mission endpoint calls a model. /v1/missions/next,
#                    /v1/missions/by-lesson, /v1/missions/generate and
#                    /v1/challenges/next all serve from the prepared set and the
#                    validated pool, or answer 503. ~1s, no model call, and the
#                    narration recorded for a prepared mission still matches the screen.
#   true             mission requests go through Gemini and the validator. 20-30s each,
#                    and a 503 when generation cannot produce something playable.
#
# Leaving it unset is the same as false, deliberately: an unset variable is the normal
# state of a fresh production deploy, and defaulting the other way costs a 25-second
# wait and a Gemini bill on somebody's first click.
#
# `forceRegenerate` on a request does NOT lift this — it only skips the reuse check, and
# only where generating is already permitted.
#
# Mission generation only. Hints, TICO chat, the debrief and error classification still
# call the model; DAILY_MODEL_CALL_CAP is what bounds those.
LIVE_MISSION_GENERATION=false
# Test fixtures may opt into a demo identity. Keep this false in app environments.
ALLOW_DEMO_AUTH=false
LOG_LEVEL=INFO
DAILY_MODEL_CALL_CAP=200
CORS_ORIGINS=http://localhost:3000
