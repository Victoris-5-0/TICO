# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Everything below comes from the Supabase dashboard for the TICO project.
# Ask the repo owner if you do not have dashboard access.

# =============================================================================
# 1. DATABASE  —  Dashboard ▸ Connect  (green "Connect" button, top of the page)
# =============================================================================
# Choose the **Session pooler** string (port 5432), NOT the transaction pooler.
#
#   Session pooler     port 5432  ✅ use this — full Postgres, prepared statements fine
#   Transaction pooler port 6543  ❌ no prepared statements; needs extra psycopg2 config
#   Direct connection  port 5432  ❌ IPv6 only on most networks
#
# Then edit the string Supabase gives you in two ways:
#   a) change the scheme  postgresql://  ->  postgresql+psycopg2://
#   b) URL-encode the password if it contains @ : / ? # [ ] or %
#      (e.g. p@ss  ->  p%40ss)
#
DATABASE_URL=postgresql+psycopg2://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres


# =============================================================================
# 2. AUTH  —  Dashboard ▸ Project Settings ▸ API
# =============================================================================
# We VERIFY tokens; we never issue them. Supabase Auth owns login.
#
# Supabase has two signing modes. Set whichever matches this project — the
# service tries JWKS first and falls back to the shared secret.
#
# ── Mode A: JWT Signing Keys (asymmetric, ES256) — the current default ────────
# Just give the project URL. The service derives the public-key endpoint at
#   <SUPABASE_URL>/auth/v1/jwks
# and verifies locally. Nothing secret is involved; the public key is public.
# Dashboard ▸ Project Settings ▸ API ▸ Project URL
SUPABASE_URL=https://PROJECTREF.supabase.co

# ── Mode B: legacy shared secret (HS256) — older projects only ───────────────
# Dashboard ▸ Project Settings ▸ API ▸ JWT Settings ▸ JWT Secret
# Leave EMPTY if the project uses Mode A.
JWT_SECRET=

# Standard for Supabase. Do not change unless auth is customised.
JWT_AUDIENCE=authenticated

# If BOTH of the above are empty and ENVIRONMENT is not production, the service
# runs in DEV MODE: unauthenticated requests are accepted and served as a demo
# user, so the client can integrate against the stubs. In production, empty
# auth config is a hard startup failure.


# =============================================================================
# 3. GOOGLE GEMINI  —  aistudio.google.com/apikey
# =============================================================================
# Check the rate limit on whichever tier this key is on. A per-minute cap that
# trips during the demo looks exactly like a broken service.
GOOGLE_API_KEY=


# =============================================================================
# 4. OPTIONAL — only if this service ever touches Supabase Storage or PostgREST
# =============================================================================
# Dashboard ▸ Project Settings ▸ API ▸ service_role key.
# NOT needed for normal operation: we reach Postgres directly via SQLAlchemy.
# This key bypasses row-level security completely. Never expose it to a client.
SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# 5. APP
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DAILY_MODEL_CALL_CAP=200
CORS_ORIGINS=http://localhost:3000
