# Copy to .env and fill in. Never commit .env.

# The same Postgres the Next.js client uses. Prisma owns the schema; this service only
# reads and writes. Ask the repo owner for the connection string.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres

# Token verification. We verify, we never issue.
# UNCONFIRMED: assumes Supabase Auth (HS256 over the project JWT secret).
JWT_SECRET=
JWT_AUDIENCE=authenticated
JWT_ALGORITHMS=HS256

# Google Gemini
GOOGLE_API_KEY=

ENVIRONMENT=development
LOG_LEVEL=INFO
DAILY_MODEL_CALL_CAP=200
CORS_ORIGINS=http://localhost:3000
