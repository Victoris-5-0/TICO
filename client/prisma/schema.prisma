// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SubmissionStatus {
  PENDING
  PASSED
  FAILED
  ERROR
}

enum SessionKind {
  LESSON
  DIAGNOSTIC
  CHALLENGE
}

enum Phase {
  ENCOUNTER
  EXPLORE
  DISCOVER
  UNDERSTAND
  GUIDED_CODING
  ADAPT_REMIX
  INDEPENDENT
}

enum SessionOutcome {
  IN_PROGRESS
  SOLVED
  ABANDONED
  TIMED_OUT
}

enum ScaffoldLevel {
  NONE
  PARTIAL
  FULL
}

enum ErrorFamily {
  SYNTAX
  NAME
  TYPE
  LOGIC
  INCOMPLETE
  RUNTIME
  UNKNOWN
}

enum XpSource {
  EXERCISE_SOLVED
  LESSON_COMPLETED
  ACHIEVEMENT
  CHALLENGE
  STREAK_BONUS
  MANUAL
}

enum ItemType {
  COSMETIC
  POWER_UP
  BADGE
  CURRENCY
}

enum ClassroomRole {
  STUDENT
  ASSISTANT
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String?
  avatarUrl        String?
  role             Role              @default(STUDENT)
  bio              String?
  xp               Int               @default(0)
  streak           Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  progress         UserProgress[]
  submissions      Submission[]
  companionChats   CompanionChat[]
  sessions         PracticeSession[]
  aiInteractions   AiInteraction[]
  xpEvents         XpEvent[]
  dailyActivities  DailyActivity[]
  heroes           UserHero[]
  items            UserItem[]
  achievements     UserAchievement[]
  taughtClassrooms Classroom[]       @relation("TeacherClassrooms")
  classroomMembers ClassroomMember[]

  @@map("users")
}

model Track {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String
  icon        String?
  language    String      // e.g. "typescript", "python", "javascript", "rust"
  published   Boolean     @default(false)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lessons     Lesson[]
  classrooms  Classroom[]

  @@map("tracks")
}

model Lesson {
  id             String          @id @default(cuid())
  trackId        String
  track          Track           @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  description    String?
  content        String          @db.Text
  order          Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  exercises      Exercise[]
  progress       UserProgress[]
  companionChats CompanionChat[]

  @@unique([trackId, slug])
  @@map("lessons")
}

model Exercise {
  id           String       @id @default(cuid())
  lessonId     String
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  instructions String       @db.Text
  starterCode  String       @db.Text
  solutionCode String?      @db.Text
  testCases    Json         // Array of { input: string, expectedOutput: string, isHidden?: boolean }
  hints        String[]
  difficulty   Difficulty   @default(BEGINNER)
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  submissions  Submission[]
  sessions     PracticeSession[]

  @@map("exercises")
}

model Submission {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sessionId       String?          @map("session_id")
  session         PracticeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  code            String           @db.Text
  status          SubmissionStatus @default(PENDING)
  attemptNumber   Int              @default(1) @map("attempt_number")
  hintsUsedBefore Int              @default(0) @map("hints_used_before")
  errorFamily     ErrorFamily?     @map("error_family")
  errorTag        String?          @map("error_tag")
  output          String?          @db.Text
  executionTimeMs Int?
  createdAt       DateTime         @default(now())

  hintEvents      HintEvent[]

  @@map("submissions")
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@map("user_progress")
}

model CompanionChat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages  Json     // Chat conversation history: [{ role: "user" | "assistant", content: string, timestamp: string }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companion_chats")
}

model PracticeSession {
  id                 String          @id @default(cuid())
  userId             String          @map("user_id")
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId         String?         @map("exercise_id")
  exercise           Exercise?       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  generatedMissionId String?         @map("generated_mission_id")
  kind               SessionKind     @default(LESSON)
  phase              Phase?          @default(EXPLORE)
  outcome            SessionOutcome  @default(IN_PROGRESS)
  hintsUsed          Int             @default(0) @map("hints_used")
  timeSpentMs        Int             @default(0) @map("time_spent_ms")
  startedAt          DateTime        @default(now()) @map("started_at")
  endedAt            DateTime?       @map("ended_at")

  submissions        Submission[]
  hintEvents         HintEvent[]
  aiInteractions     AiInteraction[]
  xpEvents           XpEvent[]

  @@map("practice_sessions")
}

model HintEvent {
  id            String          @id @default(cuid())
  sessionId     String          @map("session_id")
  session       PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submissionId  String?         @map("submission_id")
  submission    Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  conceptId     String?         @map("concept_id")
  hintLevel     Int             @default(1) @map("hint_level")
  text          String?         @db.Text
  model         String?
  wasUsed       Boolean         @default(false) @map("was_used")
  scaffoldState ScaffoldLevel?  @map("scaffold_state")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@map("hint_events")
}

model AiInteraction {
  id             String           @id @default(cuid())
  userId         String?          @map("user_id")
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String?          @map("session_id")
  session        PracticeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  capability     String
  model          String?
  promptVersion  String?          @map("prompt_version")
  input          String?          @db.Text
  output         String?          @db.Text
  tokensIn       Int?             @map("tokens_in")
  tokensOut      Int?             @map("tokens_out")
  costUsd        Decimal?         @map("cost_usd") @db.Decimal(10, 6)
  latencyMs      Int?             @map("latency_ms")
  status         String?
  moderationFlag String?          @map("moderation_flag")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@map("ai_interactions")
}

model XpEvent {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?          @map("session_id")
  session   PracticeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  amount    Int
  source    XpSource
  reason    String?
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("xp_events")
}

model DailyActivity {
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day               DateTime @db.Date
  xpEarned          Int      @default(0) @map("xp_earned")
  sessionsCompleted Int      @default(0) @map("sessions_completed")
  minutesActive     Int      @default(0) @map("minutes_active")

  @@id([userId, day])
  @@map("daily_activity")
}

model Hero {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  nameAr      String?    @map("name_ar")
  description String?
  spriteUrl   String?    @map("sprite_url")
  unlockRule  Json?      @map("unlock_rule")
  createdAt   DateTime   @default(now())

  users       UserHero[]

  @@map("heroes")
}

model UserHero {
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heroId     String   @map("hero_id")
  hero       Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  isActive   Boolean  @default(false) @map("is_active")
  acquiredAt DateTime @default(now()) @map("acquired_at")

  @@id([userId, heroId])
  @@map("user_heroes")
}

model Item {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  nameAr      String?    @map("name_ar")
  description String?
  type        ItemType   @default(COSMETIC)
  spriteUrl   String?    @map("sprite_url")
  cost        Int        @default(0)
  createdAt   DateTime   @default(now())

  users       UserItem[]

  @@map("items")
}

model UserItem {
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String   @map("item_id")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  acquiredAt DateTime @default(now()) @map("acquired_at")

  @@id([userId, itemId])
  @@map("user_items")
}

model Achievement {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  nameAr      String?           @map("name_ar")
  description String?
  iconUrl     String?           @map("icon_url")
  criteria    Json?
  xpReward    Int               @default(50) @map("xp_reward")
  createdAt   DateTime          @default(now())

  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String      @map("achievement_id")
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")

  @@id([userId, achievementId])
  @@map("user_achievements")
}

model Classroom {
  id        String            @id @default(cuid())
  name      String
  joinCode  String            @unique @map("join_code")
  teacherId String            @map("teacher_id")
  teacher   User              @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  trackId   String?           @map("track_id")
  track     Track?            @relation(fields: [trackId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  members   ClassroomMember[]

  @@map("classrooms")
}

model ClassroomMember {
  classroomId String        @map("classroom_id")
  classroom   Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ClassroomRole @default(STUDENT)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  @@id([classroomId, userId])
  @@map("classroom_members")
}
