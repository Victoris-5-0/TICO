# ==========================================
# TICO - Environment Variables Example
# ==========================================

# PostgreSQL Database Connection URL (PgBouncer pooler for serverless queries)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=10"

# Direct PostgreSQL Connection URL (Used for Prisma migrations & schema changes)
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth runs in the Next.js backend and stores sessions in PostgreSQL.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="[RANDOM_32_BYTE_SECRET]"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth credentials stay server-side. In Google Cloud, authorize:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="[YOUR_GOOGLE_CLIENT_ID].apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="[YOUR_GOOGLE_CLIENT_SECRET]"

# External Python AI Service (FastAPI)
# Required. The Python AI service. No default — an unset value fails loudly
# rather than silently calling whatever host was last hardcoded here.
AI_SERVICE_URL="https://ai.example.invalid"
AI_SERVICE_API_KEY="tico-internal-ai-key-secret"

# Node Environment
NODE_ENV="development"

# Voice narration (pre-generation only; never read at runtime).
# Free-tier keys can use premade voices only — library voices return 402.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"
